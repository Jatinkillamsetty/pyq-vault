# Local dev DB (SQLite — zero setup, file lives at prisma/dev.db).
# For production, swap to a Postgres URL and change the provider in schema.prisma back to "postgresql".
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated list of allowed email domains for signup/login
ALLOWED_EMAIL_DOMAINS="amrita.edu,cb.amrita.edu"

# Google OAuth (optional — restrict to @amrita.edu / @cb.amrita.edu at the callback level)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini 1.5 Flash (auto-tagging + cheatsheet generation)
GEMINI_API_KEY=""

# File storage (pick one)
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# or
CLOUDINARY_URL=""
